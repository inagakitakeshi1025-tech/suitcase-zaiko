# kintone接続設定(在庫管理Web化用)
# このファイルを「.env」という名前でコピーし、実際の値を入力してください(ローカル動作確認用)。
# Render本番環境では、この内容を Render ダッシュボードの Environment Variables に登録する。
# .env は秘密情報(APIトークン)を含むため、他人と共有・Gitにコミットしないこと。

# 例: https://your-subdomain.cybozu.com
KINTONE_BASE_URL=https://your-subdomain.cybozu.com

# 在庫管理アプリ(一覧の閲覧のみ。書き込みは出庫管理・入庫管理アプリ経由)
KINTONE_ZAIKO_APP_ID=
KINTONE_ZAIKO_API_TOKEN=

# 出庫管理アプリ(レコード追加が必要。権限「レコード閲覧・追加」)
KINTONE_SHUKKO_APP_ID=
KINTONE_SHUKKO_API_TOKEN=

# 入庫管理アプリ(レコード追加が必要。権限「レコード閲覧・追加」)
KINTONE_NYUKO_APP_ID=
KINTONE_NYUKO_API_TOKEN=

# パーツ管理アプリ(商品マスタ。閲覧のみでよい。権限「レコード閲覧」)
KINTONE_PARTS_APP_ID=
KINTONE_PARTS_API_TOKEN=

# 店舗マスタアプリ(出庫元・入庫先のルックアップ参照先。閲覧のみでよい。権限「レコード閲覧」)
KINTONE_STORE_APP_ID=
KINTONE_STORE_API_TOKEN=

# このアプリ自体のログイン用(Basic認証)。URLとこのID・パスワードを知っている人だけが使える。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ローカル動作確認時のポート番号(Render本番では自動で割り当てられるため通常は不要)
PORT=8080
